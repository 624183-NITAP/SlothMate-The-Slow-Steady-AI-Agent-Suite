# Port to listen on (Render automatically provides PORT in production)
PORT=3000

# (Optional) Hugging Face Open-Weight Model & Token
# Leave blank to use the built-in offline open agent & client-side Transformers.js
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# (Optional) Local Ollama Endpoint (for running models locally via ollama run llama3.2)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
